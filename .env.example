# ─── Core ────────────────────────────────────────────────────────────────────
APP_NAME=freebuff-voice
ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Docker compose uses mongodb://mongo:27017 — locally use mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=freebuff_voice

# ─── OpenRouter (LLM) ────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fast/free models to start with (tool calling required for agent actions):
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   qwen/qwen-2.5-72b-instruct
OPENROUTER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Cheaper/faster model used for post-call summaries
OPENROUTER_SUMMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: app attribution headers for OpenRouter rankings
OPENROUTER_APP_URL=https://github.com/your-org/freebuff-voice

# ─── STT (self-hosted, no paid APIs) ─────────────────────────────────────────
# mock  | whisper            | indicconformer
STT_BACKEND=whisper
# tiny | base | small | medium | large-v3  (Indic quality improves with size)
STT_MODEL_SIZE=small
STT_DEVICE=cpu            # cpu | cuda
STT_COMPUTE_TYPE=int8     # int8 | float16 | float32
# HuggingFace model id used when STT_BACKEND=indicconformer
STT_HF_MODEL_ID=ai4bharat/IndicConformer

# ─── TTS (self-hosted, no paid APIs) ─────────────────────────────────────────
# mock | piper | indic_parler
TTS_BACKEND=piper
TTS_DEVICE=cpu            # cpu | cuda
# Directory holding Piper .onnx voices, e.g. hi_IN-swara-medium.onnx
TTS_PIPER_VOICES_DIR=./models/piper
# HuggingFace model id used when TTS_BACKEND=indic_parler
TTS_HF_MODEL_ID=ai4bharat/indic-parler-tts

# ─── VAD ─────────────────────────────────────────────────────────────────────
# silero | energy (energy works everywhere, silero is better)
VAD_BACKEND=silero

# ─── Telephony (Asterisk ARI) ────────────────────────────────────────────────
# Leave ARI_BASE_URL empty to disable the telephony bridge (browser-only mode)
ARI_BASE_URL=http://localhost:8088
ARI_USERNAME=freebuff
ARI_PASSWORD=change-me-ari-password
ARI_STASIS_APP=freebuff-voice
# Where Asterisk should send RTP media for externalMedia channels.
# Must be reachable FROM the Asterisk box.
MEDIA_HOST=127.0.0.1
MEDIA_PORT=20000
# Caller-id used for ARI originate, e.g. "Sales <918000000000>"
SIP_CALLER_ID=freebuff-voice <918000000000>
SIP_TRUNK_ENDPOINT=pjsip:trunk
DIAL_TIMEOUT_SECONDS=45

# ─── Compliance (TRAI / DND) ─────────────────────────────────────────────────
CALL_TIMEZONE=Asia/Kolkata
# TRAI whitelist hours for commercial communication (9am–9pm default)
CALL_WINDOW_START=9
CALL_WINDOW_END=21
SCRUB_DND_ENABLED=true
MAX_CONCURRENT_CALLS=3

# ─── Media storage ───────────────────────────────────────────────────────────
RECORDING_DIR=./recordings

# ─── Frontend ────────────────────────────────────────────────────────────────
# Vite var (baked at build time)
VITE_API_URL=http://localhost:8000
